# ============================================================
#  Variabili d'ambiente del Portale Allievi Ufficiali
#
#  Questo file è solo un ELENCO: non contiene nessuna password vera ed è
#  l'unico file .env che può stare su GitHub. I valori veri si impostano
#  nel pannello dell'hosting (Render → Settings → Environment), mai qui.
# ============================================================

# ── DATABASE (obbligatorie) ─────────────────────────────────────────
# Dati della connessione MySQL su Railway. Si trovano nella variabile
# MYSQL_PUBLIC_URL del servizio MySQL, nella forma:
#   mysql://UTENTE:PASSWORD@HOST:PORTA/NOME_DATABASE
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# ── SESSIONI (obbligatoria in produzione) ───────────────────────────
# Stringa lunga e casuale con cui vengono firmati i token di accesso.
# Se cambia, tutti gli utenti devono rifare il login.
JWT_SECRET=

# ── EMAIL: recupero password ────────────────────────────────────────
# Senza queste due variabili il pulsante "Password dimenticata" risponde
# comunque all'utente, ma nessuna email parte (l'admin può però generare
# il link a mano dalla Gestione Utenti).
#
# Con Gmail:
#   1. attiva la verifica in due passaggi sull'account Google
#   2. crea una "password per le app" su myaccount.google.com/apppasswords
#   3. incolla qui sotto l'indirizzo Gmail e quella password di 16 lettere
#      (NON la password normale dell'account)
SMTP_USER=
SMTP_PASS=

# Opzionali.
# SMTP_PORT: 465 (TLS diretto, predefinita) oppure 587 (STARTTLS). Se l'invio
# fallisce con "Connection timeout" può darsi che l'hosting blocchi la 465:
# in quel caso prova 587. La prova si fa dal pulsante "Prova email" nella
# pagina Gestione Utenti, che mostra l'errore esatto.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=Portale Allievi Ufficiali <indirizzo@esempio.it>
#
# Il server usa solo indirizzi IPv4 per raggiungere il server di posta, perché
# l'hosting espone un'interfaccia IPv6 senza però avere una rotta verso
# l'esterno (errore "connect ENETUNREACH ...:465"). Mettere 1 qui riabilita
# anche l'IPv6: da usare solo se un giorno servisse davvero.
# SMTP_ALLOW_IPV6=0

# Indirizzo pubblico del sito, usato per costruire il link di reimpostazione
# inviato per email. Se non impostato viene dedotto dalla richiesta.
# APP_URL=https://sito-allievi-accademia-militare.onrender.com

# ── APP ANDROID (facoltative) ───────────────────────────────────────
# Servono solo se un giorno si pubblica un vero pacchetto Android (TWA):
# insieme fanno servire /.well-known/assetlinks.json, che collega app e sito.
# Finché restano vuote quella rotta risponde 404 e non cambia nulla.
# ANDROID_PACKAGE_NAME=
# ANDROID_SHA256_CERT=
